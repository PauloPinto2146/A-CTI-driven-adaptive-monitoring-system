<Sysmon schemaversion="4.91">
    <HashAlgorithms>SHA256</HashAlgorithms>
    <EventFiltering>
        <!--== Sysmon event 3 ==-->
        <RuleGroup name="" groupRelation="or">
            <NetworkConnect onmatch="include">
                <Image condition="image">rundll32.exe</Image>
                <Image condition="image">wiseman.exe</Image>
                <Rule groupRelation="and">
                    <Protocol condition="is">udp</Protocol>
                    <DestinationPort condition="is">53</DestinationPort>
                </Rule>
            </NetworkConnect>
        </RuleGroup>
        <!--== Sysmon event 6 ==-->
        <RuleGroup name="" groupRelation="or">
            <DriverLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="contains any">\Users\;Temp\;AppData\</Image>
                    <Image condition="end with">.sys</Image>
                </Rule>
            </DriverLoad>
            <DriverLoad onmatch="include">
                <Rule groupRelation="or">
                    <Signed condition="is">false</Signed>
                    <SignatureStatus condition="is not">Valid</SignatureStatus>
                </Rule>
            </DriverLoad>
        </RuleGroup>
        <!--== Sysmon event 7 ==-->
        <RuleGroup name="" groupRelation="or">
            <!-- IOC: malicious DLL loaded (wininet.dll) -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <ImageLoaded condition="is">C:\Windows\System32\wininet.dll</ImageLoaded>
                    <Hashes condition="is">fda9864b1aa230b60d0c736559415ac9c79e240cce411daed5da2facb9ced87c</Hashes>
                </Rule>
            </ImageLoad>
            <!-- IOC: malicious process image (wiseman.exe) -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="contains">wiseman.exe</Image>
                </Rule>
            </ImageLoad>
            <!-- BEHAVIOR: rundll32.exe loading modules with suspicious extensions -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <ImageLoaded condition="contains any">.dll;.cpl;.sct;.hta;.js</ImageLoaded>
                </Rule>
            </ImageLoad>
            <!-- BEHAVIOR: rundll32.exe loading unsigned/invalid‑signed modules -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <Signed condition="is">false</Signed>
                </Rule>
            </ImageLoad>
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <SignatureStatus condition="is not">Valid</SignatureStatus>
                </Rule>
            </ImageLoad>
            <!-- DERIVED: cmd.exe loading modules from temporary or public directories -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">cmd.exe</Image>
                    <ImageLoaded condition="contains any">%TEMP%;C:\Users\Public</ImageLoaded>
                </Rule>
            </ImageLoad>
            <!-- DERIVED: any PaperCut‑related process loading unsigned modules -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="contains">PaperCut</Image>
                    <Signed condition="is not">true</Signed>
                </Rule>
            </ImageLoad>
        </RuleGroup>
        <!--== Sysmon event 10 ==-->
        <RuleGroup name="" groupRelation="or">
            <ProcessAccess onmatch="include">
                <!-- IOC: wiseman.exe accessing LSASS -->
                <Rule groupRelation="and">
                    <SourceImage condition="contains">wiseman.exe</SourceImage>
                    <TargetImage condition="image">lsass.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x1FFFFF;0x1F1FFF;0x1010;0x143A</GrantedAccess>
                    <CallTrace condition="contains any">ntdll!ZwOpenProcess;advapi32!OpenProcessToken</CallTrace>
                </Rule>
                <!-- BEHAVIOR: Token‑manipulation activity targeting LSASS (T1134) -->
                <Rule groupRelation="and">
                    <TargetImage condition="image">lsass.exe</TargetImage>
                    <GrantedAccess condition="is">0x1FFFFF</GrantedAccess>
                    <CallTrace condition="contains any">ntdll!ZwOpenProcess;advapi32!OpenProcessToken;kernel32!CreateProcessAsUser;ntdll!ZwDuplicateToken</CallTrace>
                </Rule>
                <!-- BEHAVIOR: Hooking of winlogon.exe for keylogging (T1056.001) -->
                <Rule groupRelation="and">
                    <TargetImage condition="image">winlogon.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x1FFFFF;0x1010</GrantedAccess>
                    <CallTrace condition="contains any">user32!SetWindowsHookExW;user32!SetWindowsHookExA</CallTrace>
                </Rule>
                <!-- BEHAVIOR: Hooking of osk.exe for keylogging (T1056.001) -->
                <Rule groupRelation="and">
                    <TargetImage condition="image">osk.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x1FFFFF;0x1010</GrantedAccess>
                    <CallTrace condition="contains any">user32!SetWindowsHookExW;user32!SetWindowsHookExA</CallTrace>
                </Rule>
                <!-- BEHAVIOR: Use of built‑in decoding tools (T1140) -->
                <Rule groupRelation="and">
                    <SourceImage condition="contains any">certutil.exe;powershell.exe;copy.exe</SourceImage>
                    <TargetImage condition="contains any">cmd.exe;powershell.exe;certutil.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x1FFFFF;0x1010</GrantedAccess>
                    <CallTrace condition="contains any">kernel32!CreateProcessW;kernel32!CreateProcessAsUser</CallTrace>
                </Rule>
            </ProcessAccess>
        </RuleGroup>
        <!--== Sysmon event 11 ==-->
        <RuleGroup groupRelation="or">
            <FileCreate onmatch="include">
                <Rule groupRelation="and">
                    <TargetFilename condition="is">wiseman.EXE</TargetFilename>
                </Rule>
                <Rule groupRelation="and">
                    <TargetFilename condition="is">wininet.dll</TargetFilename>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="image">rundll32.exe</Image>
                    <TargetFilename condition="end with">.dll</TargetFilename>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="image">rundll32.exe</Image>
                    <TargetFilename condition="end with">.cpl</TargetFilename>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="image">rundll32.exe</Image>
                    <TargetFilename condition="contains any">.js;.sct;.hta</TargetFilename>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="image">certutil.exe</Image>
                    <TargetFilename condition="contains any">.cer;.b64;.enc;.txt;.zip;.7z</TargetFilename>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="image">powershell.exe</Image>
                    <TargetFilename condition="contains any">.b64;.enc;.txt;.zip;.7z</TargetFilename>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="image">copy.exe</Image>
                    <TargetFilename condition="contains any">.b64;.enc;.txt;.zip;.7z</TargetFilename>
                </Rule>
            </FileCreate>
        </RuleGroup>
        <!--== Sysmon event 13 ==-->
        <RuleGroup name="" groupRelation="or">
            <!-- Service start‑type modification (T1543.003) -->
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\Start</TargetObject>
            </RegistryEvent>
            <!-- Service type modification (T1543.003) -->
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\Type</TargetObject>
            </RegistryEvent>
            <!-- Service error‑control modification (T1543.003) -->
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\ErrorControl</TargetObject>
            </RegistryEvent>
            <!-- Registry Run key persistence (T1547.001) -->
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Run</TargetObject>
            </RegistryEvent>
            <!-- Policy‑based Run key persistence (T1547.001) -->
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer\Run</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer\Run</TargetObject>
            </RegistryEvent>
            <!-- SafeDllSearchMode toggle (T1112) -->
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\SafeDllSearchMode</TargetObject>
            </RegistryEvent>
            <!-- EnableLUA toggle (T1112) -->
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\EnableLUA</TargetObject>
            </RegistryEvent>
            <!-- BootExecute modification for boot‑time persistence (T1547.001) -->
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\BootExecute</TargetObject>
            </RegistryEvent>
            <!-- IOC: wiseman.EXE registered in a Run key -->
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run</TargetObject>
                <Details condition="contains">wiseman.EXE</Details>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Run</TargetObject>
                <Details condition="contains">wiseman.EXE</Details>
            </RegistryEvent>
            <!-- IOC: wininet.dll registered in a Run key -->
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run</TargetObject>
                <Details condition="contains">wininet.dll</Details>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Run</TargetObject>
                <Details condition="contains">wininet.dll</Details>
            </RegistryEvent>
        </RuleGroup>
        <!--== Sysmon event 14 ==-->
        <RuleGroup name="" groupRelation="or">
            <!-- Persistence via Run keys (T1547.001) -->
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\Software\Microsoft\Windows\CurrentVersion\Run\</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKCU\Software\Microsoft\Windows\CurrentVersion\Run\</TargetObject>
            </RegistryEvent>
            <!-- Service registry modifications (T1112) -->
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\System\CurrentControlSet\Services\</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="is">HKLM\System\CurrentControlSet\Control\Session Manager\BootExecute</TargetObject>
            </RegistryEvent>
            <!-- IOC: specific malicious binaries that may perform renames -->
            <RegistryEvent onmatch="include">
                <Image condition="end with">wiseman.exe</Image>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <Image condition="end with">wininet.dll</Image>
            </RegistryEvent>
        </RuleGroup>
        <!--== Sysmon event 22 ==-->
        <RuleGroup name="" groupRelation="or">
            <DnsQuery onmatch="include">
                <Image condition="contains">wiseman.exe</Image>
            </DnsQuery>
            <DnsQuery onmatch="include">
                <Image condition="contains">rundll32.exe</Image>
            </DnsQuery>
            <DnsQuery onmatch="include">
                <Image condition="is any">powershell.exe;python.exe;rundll32.exe</Image>
            </DnsQuery>
            <DnsQuery onmatch="include">
                <Image condition="contains">rundll32.exe</Image>
                <QueryStatus condition="is not">0</QueryStatus>
            </DnsQuery>
            <DnsQuery onmatch="include">
                <Image condition="contains">wiseman.exe</Image>
                <QueryStatus condition="is not">0</QueryStatus>
            </DnsQuery>
        </RuleGroup>
        <!--== Sysmon event 26 ==-->
        <RuleGroup name="" groupRelation="or">
            <FileDeleteDetected onmatch="include">
                <Rule groupRelation="and">
                    <Hashes condition="is">ebba8f4342b65faccdd2a48be9f2654d3fa523360f17ff68d5498a453f76c205</Hashes>
                    <TargetFilename condition="contains">wiseman.EXE</TargetFilename>
                    <Archived condition="is">true</Archived>
                </Rule>
                <Rule groupRelation="and">
                    <Hashes condition="is">fda9864b1aa230b60d0c736559415ac9c79e240cce411daed5da2facb9ced87c</Hashes>
                    <TargetFilename condition="contains">wininet.dll</TargetFilename>
                    <Archived condition="is">true</Archived>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="end with">sdelete.exe</Image>
                    <Archived condition="is">true</Archived>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="end with">cmd.exe</Image>
                    <Archived condition="is">true</Archived>
                </Rule>
                <Rule groupRelation="and">
                    <Archived condition="is">false</Archived>
                </Rule>
            </FileDeleteDetected>
        </RuleGroup>
        <!--== Sysmon event 1 ==-->
        <ProcessCreate onmatch="exclude" />
        <!--== Sysmon event 5 ==-->
        <ProcessTerminate onmatch="include" />
    </EventFiltering>
</Sysmon>