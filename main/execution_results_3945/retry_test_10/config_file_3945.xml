<Sysmon schemaversion="4.91">
    <HashAlgorithms>SHA256</HashAlgorithms>
    <EventFiltering>
        <!--== Sysmon event 3 ==-->
        <RuleGroup name="" groupRelation="or">
            <NetworkConnect onmatch="include">
                <!-- IOC: wiseman.exe -->
                <Rule groupRelation="and">
                    <Image condition="image">wiseman.exe</Image>
                </Rule>
                <!-- BEHAVIOR: Rundll32 abuse (T1218.011) -->
                <Rule groupRelation="and">
                    <Image condition="image">rundll32.exe</Image>
                </Rule>
                <!-- BEHAVIOR: DNS tunneling over UDP (T1071.004) -->
                <Rule groupRelation="and">
                    <Protocol condition="is">udp</Protocol>
                    <DestinationPort condition="is">53</DestinationPort>
                </Rule>
                <!-- BEHAVIOR: Remote Services – RDP (T1021) -->
                <Rule groupRelation="and">
                    <DestinationPort condition="is">3389</DestinationPort>
                </Rule>
                <!-- BEHAVIOR: Remote Services – SSH (T1021) -->
                <Rule groupRelation="and">
                    <DestinationPort condition="is">22</DestinationPort>
                </Rule>
                <!-- BEHAVIOR: Remote System Discovery via net.exe to SMB (T1018) -->
                <Rule groupRelation="and">
                    <Image condition="image">net.exe</Image>
                    <DestinationPort condition="is">445</DestinationPort>
                </Rule>
            </NetworkConnect>
        </RuleGroup>
        <!--== Sysmon event 6 ==-->
        <RuleGroup name="" groupRelation="or">
            <DriverLoad onmatch="include">
                <!-- Path contains C:\Users\ -->
                <Rule groupRelation="and">
                    <Image condition="contains">C:\Users\</Image>
                    <Signed condition="is">false</Signed>
                    <SignatureStatus condition="is">Invalid</SignatureStatus>
                </Rule>
                <!-- Path contains C:\Temp\ -->
                <Rule groupRelation="and">
                    <Image condition="contains">C:\Temp\</Image>
                    <Signed condition="is">false</Signed>
                    <SignatureStatus condition="is">Invalid</SignatureStatus>
                </Rule>
                <!-- Suspicious driver name svhostx.sys -->
                <Rule groupRelation="and">
                    <Image condition="image">svhostx.sys</Image>
                    <Signed condition="is">false</Signed>
                    <SignatureStatus condition="is">Invalid</SignatureStatus>
                </Rule>
                <!-- Suspicious driver name winhelp.sys -->
                <Rule groupRelation="and">
                    <Image condition="image">winhelp.sys</Image>
                    <Signed condition="is">false</Signed>
                    <SignatureStatus condition="is">Invalid</SignatureStatus>
                </Rule>
                <!-- Driver name contains the word “service” -->
                <Rule groupRelation="and">
                    <Image condition="contains">service</Image>
                    <Signed condition="is">false</Signed>
                    <SignatureStatus condition="is">Invalid</SignatureStatus>
                </Rule>
                <!-- Any unsigned/invalid .sys driver -->
                <Rule groupRelation="and">
                    <Image condition="end with">.sys</Image>
                    <Signed condition="is">false</Signed>
                    <SignatureStatus condition="is">Invalid</SignatureStatus>
                </Rule>
            </DriverLoad>
        </RuleGroup>
        <!--== Sysmon event 7 ==-->
        <RuleGroup name="" groupRelation="or">
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Hashes condition="is">ebba8f4342b65faccdd2a48be9f2654d3fa523360f17ff68d5498a453f76c205</Hashes>
                </Rule>
                <Rule groupRelation="and">
                    <Hashes condition="is">fda9864b1aa230b60d0c736559415ac9c79e240cce411daed5da2facb9ced87c</Hashes>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <ImageLoaded condition="end with">.cpl</ImageLoaded>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="end with">cmd.exe</Image>
                    <ImageLoaded condition="contains any">Temp;Public</ImageLoaded>
                </Rule>
            </ImageLoad>
        </RuleGroup>
        <!--== Sysmon event 10 ==-->
        <RuleGroup name="" groupRelation="or">
            <ProcessAccess onmatch="include">
                <!-- Indicator: wiseman.exe as source -->
                <Rule groupRelation="and">
                    <SourceImage condition="contains">wiseman.exe</SourceImage>
                </Rule>
                <!-- Behavior T1134 – access to LSASS with read‑type rights -->
                <Rule groupRelation="and">
                    <TargetImage condition="is">C:\Windows\System32\lsass.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x0010;0x0400</GrantedAccess>
                    <CallTrace condition="contains">advapi32.dll</CallTrace>
                </Rule>
                <Rule groupRelation="and">
                    <TargetImage condition="is">C:\Windows\System32\lsass.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x0010;0x0400</GrantedAccess>
                    <CallTrace condition="contains">kernel32.dll</CallTrace>
                </Rule>
                <!-- Behavior T1056.001 – keylogging‑related process access to winlogon.exe or osk.exe with high‑privilege rights -->
                <Rule groupRelation="and">
                    <TargetImage condition="is any">C:\Windows\System32\winlogon.exe;C:\Windows\System32\osk.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x1F0FFF;0x0010;0x0400</GrantedAccess>
                    <CallTrace condition="contains">user32.dll</CallTrace>
                </Rule>
                <Rule groupRelation="and">
                    <TargetImage condition="is any">C:\Windows\System32\winlogon.exe;C:\Windows\System32\osk.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x1F0FFF;0x0010;0x0400</GrantedAccess>
                    <CallTrace condition="contains">kernel32.dll</CallTrace>
                </Rule>
            </ProcessAccess>
        </RuleGroup>
        <!--== Sysmon event 11 ==-->
        <RuleGroup groupRelation="or">
            <!-- IOC: specific malicious filenames -->
            <FileCreate onmatch="include">
                <TargetFilename condition="is">wiseman.EXE</TargetFilename>
            </FileCreate>
            <FileCreate onmatch="include">
                <TargetFilename condition="is">wininet.dll</TargetFilename>
            </FileCreate>
            <!-- T1218.011 – Rundll32 creating suspicious file types -->
            <FileCreate onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="image">rundll32.exe</Image>
                    <TargetFilename condition="end with">.dll</TargetFilename>
                </Rule>
            </FileCreate>
            <FileCreate onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="image">rundll32.exe</Image>
                    <TargetFilename condition="end with">.cpl</TargetFilename>
                </Rule>
            </FileCreate>
            <FileCreate onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="image">rundll32.exe</Image>
                    <TargetFilename condition="end with">.sct</TargetFilename>
                </Rule>
            </FileCreate>
            <FileCreate onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="image">rundll32.exe</Image>
                    <TargetFilename condition="end with">.hta</TargetFilename>
                </Rule>
            </FileCreate>
            <FileCreate onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="image">rundll32.exe</Image>
                    <TargetFilename condition="end with">.js</TargetFilename>
                </Rule>
            </FileCreate>
            <!-- T1140 – Built‑in decoding tools creating executable payloads -->
            <FileCreate onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="image">certutil.exe</Image>
                    <TargetFilename condition="end with">.exe</TargetFilename>
                </Rule>
            </FileCreate>
            <FileCreate onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="image">powershell.exe</Image>
                    <TargetFilename condition="end with">.exe</TargetFilename>
                </Rule>
            </FileCreate>
            <FileCreate onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="image">copy.exe</Image>
                    <TargetFilename condition="end with">.exe</TargetFilename>
                </Rule>
            </FileCreate>
            <!-- T1027 – Creation of compressed/encoded containers -->
            <FileCreate onmatch="include">
                <TargetFilename condition="end with">.zip</TargetFilename>
            </FileCreate>
            <FileCreate onmatch="include">
                <TargetFilename condition="end with">.7z</TargetFilename>
            </FileCreate>
            <FileCreate onmatch="include">
                <TargetFilename condition="end with">.enc</TargetFilename>
            </FileCreate>
        </RuleGroup>
        <!--== Sysmon event 13 ==-->
        <RuleGroup name="" groupRelation="or">
            <!-- IOC: wiseman.exe modifying any registry value -->
            <RegistryEvent onmatch="include">
                <Image condition="contains">wiseman.exe</Image>
            </RegistryEvent>
            <!-- BEHAVIOR: Service creation/modification via sc.exe -->
            <RegistryEvent onmatch="include">
                <Image condition="end with">sc.exe</Image>
                <TargetObject condition="begin with">HKLM\SYSTEM\CurrentControlSet\Services\</TargetObject>
            </RegistryEvent>
            <!-- BEHAVIOR: Service creation/modification via PowerShell -->
            <RegistryEvent onmatch="include">
                <Image condition="end with">powershell.exe</Image>
                <TargetObject condition="begin with">HKLM\SYSTEM\CurrentControlSet\Services\</TargetObject>
            </RegistryEvent>
            <!-- BEHAVIOR: Startup/Run key persistence via sc.exe -->
            <RegistryEvent onmatch="include">
                <Image condition="end with">sc.exe</Image>
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run</TargetObject>
            </RegistryEvent>
            <!-- BEHAVIOR: Startup/Run key persistence via PowerShell -->
            <RegistryEvent onmatch="include">
                <Image condition="end with">powershell.exe</Image>
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run</TargetObject>
            </RegistryEvent>
            <!-- BEHAVIOR: svchost.exe modifying registry (e.g., keylogging related) -->
            <RegistryEvent onmatch="include">
                <Image condition="end with">svchost.exe</Image>
            </RegistryEvent>
        </RuleGroup>
        <!--== Sysmon event 14 ==-->
        <RuleGroup name="" groupRelation="or">
            <!-- IOC: rename to wiseman.EXE in Run keys -->
            <RegistryEvent onmatch="include">
                <Image condition="is any">reg.exe;powershell.exe;cmd.exe</Image>
                <TargetObject condition="begin with">HKLM\Software\Microsoft\Windows\CurrentVersion\Run</TargetObject>
                <NewName condition="is">wiseman.EXE</NewName>
            </RegistryEvent>
            <!-- IOC: rename to wininet.dll in Run keys -->
            <RegistryEvent onmatch="include">
                <Image condition="is any">reg.exe;powershell.exe;cmd.exe</Image>
                <TargetObject condition="begin with">HKLM\Software\Microsoft\Windows\CurrentVersion\Run</TargetObject>
                <NewName condition="is">wininet.dll</NewName>
            </RegistryEvent>
            <!-- BEHAVIOR: Service registry rename (T1543.003) -->
            <RegistryEvent onmatch="include">
                <Image condition="is any">svchost.exe;services.exe</Image>
                <TargetObject condition="begin with">HKLM\System\CurrentControlSet\Services\</TargetObject>
            </RegistryEvent>
            <!-- BEHAVIOR: Run‑key/Startup folder rename (T1547.001) -->
            <RegistryEvent onmatch="include">
                <Image condition="is any">explorer.exe;userinit.exe</Image>
                <TargetObject condition="begin with">HKLM\Software\Microsoft\Windows\CurrentVersion\Run</TargetObject>
            </RegistryEvent>
            <!-- DERIVED: BootExecute rename for persistence -->
            <RegistryEvent onmatch="include">
                <Image condition="is any">services.exe;sc.exe</Image>
                <TargetObject condition="begin with">HKLM\System\CurrentControlSet\Control\Session Manager\BootExecute</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <!--== Sysmon event 22 ==-->
        <RuleGroup name="Suspicious DNS Queries" groupRelation="or">
            <DnsQuery onmatch="include">
                <Image condition="contains">wiseman.EXE</Image>
            </DnsQuery>
            <DnsQuery onmatch="include">
                <Image condition="contains any">powershell.exe;python.exe;rundll32.exe</Image>
            </DnsQuery>
        </RuleGroup>
        <!--== Sysmon event 26 ==-->
        <RuleGroup name="" groupRelation="or">
            <FileDeleteDetected onmatch="include">
                <Rule groupRelation="and">
                    <Hashes condition="is">ebba8f4342b65faccdd2a48be9f2654d3fa523360f17ff68d5498a453f76c205</Hashes>
                    <IsExecutable condition="is">true</IsExecutable>
                    <Archived condition="is">true</Archived>
                </Rule>
                <Rule groupRelation="and">
                    <Hashes condition="is">fda9864b1aa230b60d0c736559415ac9c79e240cce411daed5da2facb9ced87c</Hashes>
                    <IsExecutable condition="is">false</IsExecutable>
                    <Archived condition="is">true</Archived>
                </Rule>
            </FileDeleteDetected>
        </RuleGroup>
        <!--== Sysmon event 1 ==-->
        <ProcessCreate onmatch="exclude" />
        <!--== Sysmon event 5 ==-->
        <ProcessTerminate onmatch="include" />
    </EventFiltering>
</Sysmon>