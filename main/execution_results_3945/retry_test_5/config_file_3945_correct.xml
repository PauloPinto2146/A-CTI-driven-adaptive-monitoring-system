<Sysmon schemaversion="4.91">
    <HashAlgorithms>SHA256</HashAlgorithms>
    <EventFiltering>
        <!--== Sysmon event 1 ==-->
        <RuleGroup name="include_malicious" groupRelation="or">
            <!-- IOC: specific malicious executable -->
            <ProcessCreate onmatch="include">
                <Image condition="is">wiseman.EXE</Image>
                <Hashes condition="is">SHA256:ebba8f4342b65faccdd2a48be9f2654d3fa523360f17ff68d5498a453f76c205</Hashes>
            </ProcessCreate>
            <!-- T1033 – System Owner/User Discovery -->
            <ProcessCreate onmatch="include">
                <Image condition="is">whoami.exe</Image>
            </ProcessCreate>
            <ProcessCreate onmatch="include">
                <Image condition="is">query.exe</Image>
                <CommandLine condition="contains">user</CommandLine>
            </ProcessCreate>
            <ProcessCreate onmatch="include">
                <Image condition="is">net.exe</Image>
                <CommandLine condition="contains">user</CommandLine>
            </ProcessCreate>
            <!-- T1218.011 – Rundll32 Abuse -->
            <ProcessCreate onmatch="include">
                <Image condition="is">rundll32.exe</Image>
                <CommandLine condition="contains">.dll</CommandLine>
            </ProcessCreate>
            <ProcessCreate onmatch="include">
                <Image condition="is">rundll32.exe</Image>
                <CommandLine condition="contains">.cpl</CommandLine>
            </ProcessCreate>
            <ProcessCreate onmatch="include">
                <Image condition="is">rundll32.exe</Image>
                <CommandLine condition="contains">javascript:</CommandLine>
            </ProcessCreate>
            <!-- T1543.003 – Windows Service Creation/Modification -->
            <ProcessCreate onmatch="include">
                <Image condition="is">sc.exe</Image>
                <CommandLine condition="contains">create</CommandLine>
            </ProcessCreate>
            <!-- T1082 – System Information Discovery -->
            <ProcessCreate onmatch="include">
                <Image condition="is">systeminfo.exe</Image>
            </ProcessCreate>
            <!-- T1140 – Deobfuscate/Decode Files or Information -->
            <ProcessCreate onmatch="include">
                <Image condition="is">certutil.exe</Image>
                <CommandLine condition="contains">-decode</CommandLine>
            </ProcessCreate>
            <ProcessCreate onmatch="include">
                <Image condition="is">copy.exe</Image>
                <CommandLine condition="contains">/b</CommandLine>
            </ProcessCreate>
            <ProcessCreate onmatch="include">
                <Image condition="is">powershell.exe</Image>
                <CommandLine condition="contains">-EncodedCommand</CommandLine>
            </ProcessCreate>
            <!-- T1021 – Remote Services -->
            <ProcessCreate onmatch="include">
                <Image condition="is">mstsc.exe</Image>
            </ProcessCreate>
            <ProcessCreate onmatch="include">
                <Image condition="is">ssh.exe</Image>
            </ProcessCreate>
            <!-- T1112 – Modify Registry -->
            <ProcessCreate onmatch="include">
                <Image condition="is">reg.exe</Image>
                <CommandLine condition="contains">add</CommandLine>
            </ProcessCreate>
            <ProcessCreate onmatch="include">
                <Image condition="is">reg.exe</Image>
                <CommandLine condition="contains">delete</CommandLine>
            </ProcessCreate>
            <!-- T1012 – Query Registry -->
            <ProcessCreate onmatch="include">
                <Image condition="is">reg.exe</Image>
                <CommandLine condition="contains">query</CommandLine>
            </ProcessCreate>
            <!-- T1016 – System Network Configuration Discovery -->
            <ProcessCreate onmatch="include">
                <Image condition="is">ipconfig.exe</Image>
            </ProcessCreate>
            <ProcessCreate onmatch="include">
                <Image condition="is">netsh.exe</Image>
            </ProcessCreate>
            <ProcessCreate onmatch="include">
                <Image condition="is">route.exe</Image>
            </ProcessCreate>
            <!-- T1134 – Access Token Manipulation -->
            <ProcessCreate onmatch="include">
                <Image condition="is">runas.exe</Image>
            </ProcessCreate>
            <!-- T1018 – Remote System Discovery -->
            <ProcessCreate onmatch="include">
                <Image condition="is">net.exe</Image>
                <CommandLine condition="contains">view</CommandLine>
            </ProcessCreate>
            <ProcessCreate onmatch="include">
                <Image condition="is">ping.exe</Image>
            </ProcessCreate>
            <ProcessCreate onmatch="include">
                <Image condition="is">tracert.exe</Image>
            </ProcessCreate>
        </RuleGroup>
        <!--== Sysmon event 3 ==-->
        <RuleGroup name="" groupRelation="or">
            <NetworkConnect onmatch="include">
                <!-- IOC: wiseman.exe -->
                <Rule groupRelation="and">
                    <Image condition="image">wiseman.exe</Image>
                </Rule>
                <!-- BEHAVIOR: rundll32.exe proxy execution -->
                <Rule groupRelation="and">
                    <Image condition="image">rundll32.exe</Image>
                    <Initiated condition="is">true</Initiated>
                </Rule>
                <!-- BEHAVIOR: UDP initiations excluding typical DNS clients -->
                <Rule groupRelation="and">
                    <Protocol condition="is">udp</Protocol>
                    <Initiated condition="is">true</Initiated>
                    <Image condition="is not">svchost.exe</Image>
                    <Image condition="is not">dns.exe</Image>
                </Rule>
            </NetworkConnect>
        </RuleGroup>
        <!--== Sysmon event 6 ==-->
        <RuleGroup name="" groupRelation="or">
            <!-- Unsigned driver load (T1543.003) -->
            <DriverLoad onmatch="include">
                <Rule groupRelation="and">
                    <Signed condition="is">false</Signed>
                </Rule>
            </DriverLoad>
            <!-- Driver loaded from uncommon locations (T1543.003) -->
            <DriverLoad onmatch="include">
                <Rule groupRelation="and">
                    <ImageLoaded condition="contains">C:\Users\</ImageLoaded>
                </Rule>
            </DriverLoad>
            <DriverLoad onmatch="include">
                <Rule groupRelation="and">
                    <ImageLoaded condition="contains">C:\Temp\</ImageLoaded>
                </Rule>
            </DriverLoad>
            <DriverLoad onmatch="include">
                <Rule groupRelation="and">
                    <ImageLoaded condition="contains">%AppData%\</ImageLoaded>
                </Rule>
            </DriverLoad>
            <!-- Driver with problematic or missing signature (derived from CVE‑2023‑27350) -->
            <DriverLoad onmatch="include">
                <Rule groupRelation="and">
                    <SignatureStatus condition="is any">Invalid;Unknown</SignatureStatus>
                </Rule>
            </DriverLoad>
        </RuleGroup>
        <!--== Sysmon event 7 ==-->
        <RuleGroup name="" groupRelation="or">
            <ImageLoad onmatch="include">
                <!-- IOC: wiseman.exe SHA256 hash -->
                <Rule groupRelation="and">
                    <Hashes condition="is">ebba8f4342b65faccdd2a48be9f2654d3fa523360f17ff68d5498a453f76c205</Hashes>
                </Rule>
                <!-- IOC: wininet.dll SHA256 hash -->
                <Rule groupRelation="and">
                    <Hashes condition="is">fda9864b1aa230b60d0c736559415ac9c79e240cce411daed5da2facb9ced87c</Hashes>
                </Rule>
                <!-- BEHAVIOR: rundll32.exe loading .cpl files -->
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <ImageLoaded condition="end with">.cpl</ImageLoaded>
                </Rule>
                <!-- BEHAVIOR: rundll32.exe loading unsigned modules -->
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <Signed condition="is">false</Signed>
                </Rule>
                <!-- BEHAVIOR: rundll32.exe loading modules with invalid signatures -->
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <SignatureStatus condition="is not">Valid</SignatureStatus>
                </Rule>
            </ImageLoad>
        </RuleGroup>
        <!--== Sysmon event 10 ==-->
        <RuleGroup name="" groupRelation="or">
            <ProcessAccess onmatch="include">
                <Rule groupRelation="and">
                    <SourceImage condition="image">wiseman.exe</SourceImage>
                    <TargetImage condition="image">lsass.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x0010;0x0400;0x0040</GrantedAccess>
                </Rule>
                <Rule groupRelation="and">
                    <TargetImage condition="is any">lsass.exe;winlogon.exe;services.exe;csrss.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x1F0FFF;0x0010;0x0400;0x0040</GrantedAccess>
                </Rule>
                <Rule groupRelation="and">
                    <SourceImage condition="is any">certutil.exe;powershell.exe;copy.exe</SourceImage>
                    <TargetImage condition="end with">.exe</TargetImage>
                    <GrantedAccess condition="contains">0x0080</GrantedAccess>
                </Rule>
                <Rule groupRelation="and">
                    <SourceImage condition="image">PaperCutNG.exe</SourceImage>
                    <TargetImage condition="is any">svchost.exe;services.exe</TargetImage>
                    <GrantedAccess condition="contains">0x1F0FFF</GrantedAccess>
                </Rule>
            </ProcessAccess>
        </RuleGroup>
        <!--== Sysmon event 11 ==-->
        <RuleGroup name="" groupRelation="or">
            <FileCreate onmatch="include">
                <!-- IOC: wiseman.EXE -->
                <Rule groupRelation="or">
                    <TargetFilename condition="contains">wiseman.EXE</TargetFilename>
                </Rule>
                <!-- IOC: wininet.dll -->
                <Rule groupRelation="or">
                    <TargetFilename condition="contains">wininet.dll</TargetFilename>
                </Rule>
                <!-- BEHAVIOR: Rundll32 abuse – Control Panel Item files -->
                <Rule groupRelation="or">
                    <TargetFilename condition="end with">.cpl</TargetFilename>
                </Rule>
                <!-- BEHAVIOR: Rundll32 abuse – scriptlet files -->
                <Rule groupRelation="or">
                    <TargetFilename condition="end with">.sct</TargetFilename>
                </Rule>
                <!-- BEHAVIOR: Rundll32 abuse – HTML Application files -->
                <Rule groupRelation="or">
                    <TargetFilename condition="end with">.hta</TargetFilename>
                </Rule>
                <!-- BEHAVIOR: Rundll32 abuse – JavaScript files -->
                <Rule groupRelation="or">
                    <TargetFilename condition="end with">.js</TargetFilename>
                </Rule>
                <!-- BEHAVIOR: Deobfuscation/decoding – common encoded/obfuscated extensions -->
                <Rule groupRelation="or">
                    <TargetFilename condition="contains any">.b64;.enc;.cer;.txt;.zip;.7z</TargetFilename>
                </Rule>
            </FileCreate>
        </RuleGroup>
        <!--== Sysmon event 13 ==-->
        <RuleGroup name="" groupRelation="or">
            <RegistryEvent onmatch="include">
                <Image condition="is any">sc.exe;powershell.exe;cmd.exe</Image>
                <TargetObject condition="begin with">HKLM\SYSTEM\CurrentControlSet\Services</TargetObject>
                <TargetObject condition="end with">\Start</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <Image condition="is any">sc.exe;powershell.exe;cmd.exe</Image>
                <TargetObject condition="begin with">HKLM\SYSTEM\CurrentControlSet\Services</TargetObject>
                <TargetObject condition="end with">\Type</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <Image condition="is any">reg.exe;powershell.exe;wmic.exe</Image>
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Windows</TargetObject>
                <TargetObject condition="end with">\SafeDllSearchMode</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <Image condition="is any">reg.exe;powershell.exe</Image>
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run</TargetObject>
                <TargetObject condition="end with">\Notify</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <!--== Sysmon event 14 ==-->
        <RuleGroup name="" groupRelation="or">
            <!-- Rename Run key via reg.exe (T1547.001) -->
            <RegistryEvent onmatch="include">
                <EventType condition="is">RenameKey</EventType>
                <Image condition="is">reg.exe</Image>
                <TargetObject condition="is">HKLM\Software\Microsoft\Windows\CurrentVersion\Run</TargetObject>
            </RegistryEvent>
            <!-- Rename RunOnce key via reg.exe (T1547.001) -->
            <RegistryEvent onmatch="include">
                <EventType condition="is">RenameKey</EventType>
                <Image condition="is">reg.exe</Image>
                <TargetObject condition="is">HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce</TargetObject>
            </RegistryEvent>
            <!-- Rename user Run key via powershell.exe (T1547.001) -->
            <RegistryEvent onmatch="include">
                <EventType condition="is">RenameKey</EventType>
                <Image condition="is">powershell.exe</Image>
                <TargetObject condition="is">HKCU\Software\Microsoft\Windows\CurrentVersion\Run</TargetObject>
            </RegistryEvent>
            <!-- Rename service keys via sc.exe (T1543.003) -->
            <RegistryEvent onmatch="include">
                <EventType condition="is">RenameKey</EventType>
                <Image condition="is">sc.exe</Image>
                <TargetObject condition="begin with">HKLM\SYSTEM\CurrentControlSet\Services\</TargetObject>
            </RegistryEvent>
            <!-- Rename Explorer policy Run key via reg.exe (T1112) -->
            <RegistryEvent onmatch="include">
                <EventType condition="is">RenameKey</EventType>
                <Image condition="is">reg.exe</Image>
                <TargetObject condition="is">HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer\Run</TargetObject>
            </RegistryEvent>
            <!-- IOC: wiseman.EXE renaming any registry key -->
            <RegistryEvent onmatch="include">
                <EventType condition="is">RenameKey</EventType>
                <Image condition="is">wiseman.EXE</Image>
            </RegistryEvent>
            <!-- IOC: wininet.dll renaming any registry key -->
            <RegistryEvent onmatch="include">
                <EventType condition="is">RenameKey</EventType>
                <Image condition="is">wininet.dll</Image>
            </RegistryEvent>
        </RuleGroup>
        <!--== Sysmon event 22 ==-->
        <RuleGroup name="" groupRelation="or">
            <DnsQuery onmatch="include">
                <Image condition="is">wiseman.exe</Image>
            </DnsQuery>
            <DnsQuery onmatch="include">
                <Image condition="is">rundll32.exe</Image>
            </DnsQuery>
            <DnsQuery onmatch="include">
                <Image condition="is any">powershell.exe;python.exe</Image>
            </DnsQuery>
            <DnsQuery onmatch="include">
                <Image condition="is any">net.exe;ping.exe</Image>
            </DnsQuery>
        </RuleGroup>
        <!--== Sysmon event 26 ==-->
        <RuleGroup name="FileDeletionMonitoring" groupRelation="or">
            <FileDeleteDetected onmatch="include">
                <Rule groupRelation="and">
                    <TargetFilename condition="contains">wiseman.EXE</TargetFilename>
                    <Hashes condition="is">ebba8f4342b65faccdd2a48be9f2654d3fa523360f17ff68d5498a453f76c205</Hashes>
                    <IsExecutable condition="is">true</IsExecutable>
                    <Archived condition="is">true</Archived>
                </Rule>
                <Rule groupRelation="and">
                    <TargetFilename condition="contains">wininet.dll</TargetFilename>
                    <Hashes condition="is">fda9864b1aa230b60d0c736559415ac9c79e240cce411daed5da2facb9ced87c</Hashes>
                    <IsExecutable condition="is">false</IsExecutable>
                    <Archived condition="is">true</Archived>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="contains">sdelete.exe</Image>
                    <Archived condition="is">true</Archived>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="contains">cmd.exe</Image>
                    <Archived condition="is">true</Archived>
                </Rule>
            </FileDeleteDetected>
        </RuleGroup>
        <!--== Sysmon event 5 ==-->
        <ProcessTerminate onmatch="include" />
    </EventFiltering>
</Sysmon>