<Sysmon schemaversion="4.91">
    <HashAlgorithms>SHA256</HashAlgorithms>
    <EventFiltering>
        <!--== Sysmon event 3 ==-->
        <RuleGroup name="" groupRelation="or">
            <NetworkConnect onmatch="include">
                <Image condition="image">wiseman.exe</Image>
                <DestinationHostname condition="is">pastebin.com</DestinationHostname>
                <DestinationHostname condition="is">twitter.com</DestinationHostname>
                <Rule groupRelation="and">
                    <Image condition="image">rundll32.exe</Image>
                    <Initiated condition="is">true</Initiated>
                </Rule>
            </NetworkConnect>
        </RuleGroup>
        <!--== Sysmon event 6 ==-->
        <RuleGroup name="" groupRelation="or">
            <DriverLoad>
                <!-- Unsigned driver with .sys extension -->
                <Rule groupRelation="and">
                    <ImageLoaded condition="end with">.sys</ImageLoaded>
                    <Signed condition="is">false</Signed>
                </Rule>
                <!-- Driver with non‑valid signature and .sys extension -->
                <Rule groupRelation="and">
                    <ImageLoaded condition="end with">.sys</ImageLoaded>
                    <SignatureStatus condition="is not">Valid</SignatureStatus>
                </Rule>
                <!-- Driver loaded from uncommon user directory -->
                <Rule groupRelation="and">
                    <ImageLoaded condition="begin with">C:\Users\</ImageLoaded>
                    <ImageLoaded condition="end with">.sys</ImageLoaded>
                </Rule>
                <!-- Driver loaded from uncommon temp directory -->
                <Rule groupRelation="and">
                    <ImageLoaded condition="begin with">C:\Temp\</ImageLoaded>
                    <ImageLoaded condition="end with">.sys</ImageLoaded>
                </Rule>
            </DriverLoad>
        </RuleGroup>
        <!--== Sysmon event 7 ==-->
        <RuleGroup name="" groupRelation="or">
            <!-- IOC: wininet.dll -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Hashes condition="is">fda9864b1aa230b60d0c736559415ac9c79e240cce411daed5da2facb9ced87c</Hashes>
                </Rule>
            </ImageLoad>
            <!-- IOC: wiseman.EXE -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Hashes condition="is">ebba8f4342b65faccdd2a48be9f2654d3fa523360f17ff68d5498a453f76c205</Hashes>
                </Rule>
            </ImageLoad>
            <!-- BEHAVIOR: rundll32.exe loading .cpl files -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <ImageLoaded condition="end with">.cpl</ImageLoaded>
                </Rule>
            </ImageLoad>
            <!-- BEHAVIOR: rundll32.exe loading any DLL (atypical) -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <ImageLoaded condition="end with">.dll</ImageLoaded>
                </Rule>
            </ImageLoad>
            <!-- BEHAVIOR: rundll32.exe loading script protocols or script files -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <ImageLoaded condition="contains">javascript:</ImageLoaded>
                </Rule>
            </ImageLoad>
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <ImageLoaded condition="contains">mshtml</ImageLoaded>
                </Rule>
            </ImageLoad>
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <ImageLoaded condition="end with">.sct</ImageLoaded>
                </Rule>
            </ImageLoad>
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <ImageLoaded condition="end with">.hta</ImageLoaded>
                </Rule>
            </ImageLoad>
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">rundll32.exe</Image>
                    <ImageLoaded condition="end with">.js</ImageLoaded>
                </Rule>
            </ImageLoad>
            <!-- BEHAVIOR: cmd.exe loading files from temporary or public locations -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">cmd.exe</Image>
                    <ImageLoaded condition="contains any">%TEMP%;C:\Users\Public</ImageLoaded>
                </Rule>
            </ImageLoad>
            <!-- BEHAVIOR: cmd.exe loading unsigned or improperly signed modules -->
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">cmd.exe</Image>
                    <Signed condition="is">false</Signed>
                </Rule>
            </ImageLoad>
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">cmd.exe</Image>
                    <SignatureStatus condition="is">invalid</SignatureStatus>
                </Rule>
            </ImageLoad>
            <ImageLoad onmatch="include">
                <Rule groupRelation="and">
                    <Image condition="end with">cmd.exe</Image>
                    <SignatureStatus condition="is">missing</SignatureStatus>
                </Rule>
            </ImageLoad>
        </RuleGroup>
        <!--== Sysmon event 10 ==-->
        <RuleGroup name="" groupRelation="or">
            <ProcessAccess onmatch="include">
                <!-- IOC: specific malicious source executable -->
                <Rule groupRelation="and">
                    <SourceImage condition="image">wiseman.exe</SourceImage>
                </Rule>
                <!-- BEHAVIOR: non‑UI service accessing winlogon for credential capture (T1056.001) -->
                <Rule groupRelation="and">
                    <TargetImage condition="is">C:\Windows\system32\winlogon.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x0010;0x0020;0x0080</GrantedAccess>
                </Rule>
                <!-- BEHAVIOR: non‑UI service accessing osk.exe for credential capture (T1056.001) -->
                <Rule groupRelation="and">
                    <TargetImage condition="is">C:\Windows\system32\osk.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x0010;0x0020;0x0080</GrantedAccess>
                </Rule>
                <!-- BEHAVIOR: any process reading LSASS for token manipulation (T1134) -->
                <Rule groupRelation="and">
                    <TargetImage condition="is">C:\Windows\system32\lsass.exe</TargetImage>
                    <GrantedAccess condition="contains any">0x0010;0x0400</GrantedAccess>
                </Rule>
                <!-- DERIVED: post‑exploit full‑access to LSASS after CVE‑2023‑27350 -->
                <Rule groupRelation="and">
                    <TargetImage condition="is">C:\Windows\system32\lsass.exe</TargetImage>
                    <GrantedAccess condition="is">0x1FFFFF</GrantedAccess>
                </Rule>
            </ProcessAccess>
        </RuleGroup>
        <!--== Sysmon event 11 ==-->
        <RuleGroup name="" groupRelation="or">
            <FileCreate onmatch="include">
                <TargetFilename condition="is">wiseman.EXE</TargetFilename>
            </FileCreate>
            <FileCreate onmatch="include">
                <TargetFilename condition="is">wininet.dll</TargetFilename>
            </FileCreate>
            <FileCreate onmatch="include">
                <TargetFilename condition="contains any">.cpl;.dll;.js;.sct;.hta;.txt;.cer;.enc;.b64;.zip;.7z</TargetFilename>
            </FileCreate>
            <FileCreate onmatch="include">
                <TargetFilename condition="contains">\Temp\</TargetFilename>
            </FileCreate>
        </RuleGroup>
        <!--== Sysmon event 13 ==-->
        <RuleGroup name="Include_Run_Keys" groupRelation="or">
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\Software\Microsoft\Windows\CurrentVersion\Run</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKCU\Software\Microsoft\Windows\CurrentVersion\Run</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnceEx\</TargetObject>
                <TargetObject condition="contains">\Depend</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer\Run</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <RuleGroup name="Include_Service_Creation" groupRelation="or">
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\SYSTEM\CurrentControlSet\Services</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\ImagePath</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\Start</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\Type</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <RuleGroup name="Include_Boot_Execute" groupRelation="or">
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\BootExecute</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <RuleGroup name="Include_Winlogon_Tampering" groupRelation="or">
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\Userinit</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\Shell</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <RuleGroup name="Include_SafeDllSearchMode" groupRelation="or">
            <RegistryEvent onmatch="include">
                <TargetObject condition="end with">\SafeDllSearchMode</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <RuleGroup name="IOC_wiseman_EXE" groupRelation="or">
            <RegistryEvent onmatch="include">
                <Image condition="image">wiseman.EXE</Image>
                <TargetObject condition="begin with">HKLM\Software\Microsoft\Windows\CurrentVersion\Run</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <RuleGroup name="IOC_wininet_DLL" groupRelation="or">
            <RegistryEvent onmatch="include">
                <Details condition="contains">wininet.dll</Details>
                <TargetObject condition="end with">\ImagePath</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <!--== Sysmon event 14 ==-->
        <!-- Persistence via Windows Services (T1543.003) -->
        <RuleGroup name="" groupRelation="or">
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\SYSTEM\CurrentControlSet\Services\</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <!-- Persistence via Run/RunOnce keys (T1547.001) -->
        <RuleGroup name="" groupRelation="or">
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run\</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce\</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Run\</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunServices\</TargetObject>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunServicesOnce\</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <!-- Boot Execute persistence (T1547.001) -->
        <RuleGroup name="" groupRelation="or">
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\BootExecute</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <!-- Policies Run persistence (T1547.001) -->
        <RuleGroup name="" groupRelation="or">
            <RegistryEvent onmatch="include">
                <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer\Run\</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        <!-- IOC: rename operations performed by known malicious binaries -->
        <RuleGroup name="" groupRelation="or">
            <RegistryEvent onmatch="include">
                <Image condition="end with">wiseman.exe</Image>
            </RegistryEvent>
            <RegistryEvent onmatch="include">
                <Image condition="end with">wininet.dll</Image>
            </RegistryEvent>
        </RuleGroup>
        <!--== Sysmon event 22 ==-->
        <RuleGroup name="" groupRelation="or">
            <DnsQuery>
                <Image condition="contains">wiseman.exe</Image>
            </DnsQuery>
            <DnsQuery>
                <Image condition="end with">rundll32.exe</Image>
            </DnsQuery>
            <DnsQuery>
                <Image condition="contains any">mstsc.exe;ssh.exe;plink.exe</Image>
            </DnsQuery>
            <DnsQuery>
                <Image condition="contains any">net.exe;ping.exe;tracert.exe</Image>
            </DnsQuery>
        </RuleGroup>
        <!--== Sysmon event 26 ==-->
        <RuleGroup name="" groupRelation="or">
            <FileDeleteDetected onmatch="include">
                <Rule groupRelation="and">
                    <TargetFilename condition="contains">wiseman.EXE</TargetFilename>
                    <Hashes condition="is">ebba8f4342b65faccdd2a48be9f2654d3fa523360f17ff68d5498a453f76c205</Hashes>
                    <IsExecutable condition="is">true</IsExecutable>
                    <Archived condition="is">true</Archived>
                </Rule>
                <Rule groupRelation="and">
                    <TargetFilename condition="contains">wininet.dll</TargetFilename>
                    <Hashes condition="is">fda9864b1aa230b60d0c736559415ac9c79e240cce411daed5da2facb9ced87c</Hashes>
                    <IsExecutable condition="is">false</IsExecutable>
                    <Archived condition="is">true</Archived>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="contains">del.exe</Image>
                    <Archived condition="is">true</Archived>
                </Rule>
                <Rule groupRelation="and">
                    <Image condition="contains">sdelete.exe</Image>
                    <Archived condition="is">true</Archived>
                </Rule>
            </FileDeleteDetected>
        </RuleGroup>
        <!--== Sysmon event 1 ==-->
        <ProcessCreate onmatch="exclude" />
        <!--== Sysmon event 5 ==-->
        <ProcessTerminate onmatch="include" />
    </EventFiltering>
</Sysmon>